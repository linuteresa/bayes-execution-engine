
LLAMA_CPP_BASE_URL=http://localhost:8080/v1
LLAMA_MODEL=local-gguf
LLAMA_CPP_API_KEY=not-needed


EXECUTOR_SAMPLES=4
EXECUTOR_TEMPERATURE=0.7
# self-consistency (default) | keywords  -- see core/signals.py before switching
EXECUTOR_EVIDENCE=self-consistency
# executed steps before a run stops and returns what it has
MAX_STEPS=10
# persist what the engine learns from POST /jobs/{id}/feedback
# ENGINE_STATE_PATH=./engine_counts.npy

JOB_STORE=memory
CHECKPOINTER=memory
# REDIS_URL=redis://localhost:6379/0
# POSTGRES_DSN=postgresql://localhost:5432/bayes


LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
