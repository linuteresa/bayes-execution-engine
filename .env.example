# Local model. LLAMA_MODEL is a request label, not verified weights identity.
LLAMA_CPP_BASE_URL=http://localhost:8080/v1
LLAMA_MODEL=local-gguf
LLAMA_CPP_API_KEY=not-needed
# Optional recorded acquisition identity; verify against the loaded server weights.
# LLAMA_MODEL_REVISION=repository-commit-or-server-manifest-digest
# LLAMA_WEIGHTS_SHA256=sha256-of-the-gguf-file
# LLAMA_SERVER_VERSION=llama.cpp-build-or-ollama-version
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048

EXECUTOR_SAMPLES=4
EXECUTOR_TEMPERATURE=0.7
EXECUTOR_CONTEXT_CHARS=12000
EXECUTOR_EVIDENCE=self-consistency
MAX_STEPS=10
MODEL_OUTPUT_ATTEMPTS=2
MAX_PROMPT_CHARS=16000
# EMBEDDINGS_BASE_URL=http://localhost:8081/v1
# EMBEDDINGS_MODEL=all-minilm-l6-v2

# Durable jobs + transactional feedback counts on one host.
JOB_STORE=sqlite
JOB_DB_PATH=./data/jobs.sqlite3
CHECKPOINTER=memory
JOB_MAX_PENDING=128
JOB_WORKERS=8
JOB_LEASE_SECONDS=30
JOB_RETENTION_SECONDS=86400
JOB_TIMEOUT_SECONDS=300
# JOB_STORE=redis requires requirements-redis.txt; persistent checkpoints do too.
# REDIS_URL=redis://localhost:6379/0
# REDIS_JOB_PREFIX=bayes
# CHECKPOINTER=postgres requires requirements-postgres.txt.
# POSTGRES_DSN=postgresql://user:password@localhost:5432/bayes
LANGGRAPH_STRICT_MSGPACK=true

# Optional shared bearer token for trusted API callers; not a user/ownership system.
# API_KEY=replace-with-a-random-secret
LOG_LEVEL=INFO
# Install requirements-telemetry.txt before setting the OTLP/gRPC endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
# OTEL_SERVICE_NAME=bayes-execution-engine

# Compose: bring your own model.gguf under ./models. Pin deployed image digests.
LLAMA_MODEL_FILE=model.gguf
# LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server@sha256:...
# REDIS_IMAGE=redis/redis-stack-server@sha256:...
# INSTALL_TELEMETRY=true
# INSTALL_POSTGRES=true
# ENGINE_STATE_PATH is for standalone engine counts only; API feedback uses JOB_STORE.
